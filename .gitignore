regional_pricing.xlsx
/reports

# One-off personal data exports from scripts/dump-user-journal.ts
/JOURNAL-*.md

# Streak repair planner outputs (bulk user PII). Generated by
# scripts/plan-streak-tz-repair.ts, consumed by
# scripts/apply-streak-tz-repair.ts. Do not check the JSON in.
/tz-repair-plan*.json
scripts/restore-nirdesh-project.ts

# One-off script output artifacts (e.g. validate-uwu-against-rejected-ships.json).
# These are local-only diagnostics; not source.
scripts/.out/

# Fraud / cross-YSWS dedup audit + remediation outputs. Contain prod PII
# (student names, emails, project URLs). Local-only diagnostics, never commit.
/audit-*.csv
/audit-*.md
/at-risk-*.md
/clawback-*.csv
/clawback-*.md
/fined-ships-analysis.md
/no-baseline-dig.md
# Timestamped script backup snapshots (may contain user content).
scripts/*.backup-*.json

# Budget audit outputs (prod financial data, HCB balances). Local-only
# diagnostics, never commit. Report + the read-only prod audit script.
/budget-audit-*.md
scripts/audit-budget-prod.ts

# One-off, ticket-specific prod scripts (some write to prod). Local-only,
# never commit. The generalizable tools (debug-user-balance-by-project.ts,
# validate-team-streak-engine.ts) are kept and committed.
scripts/debug-streak-2312-2317.ts
scripts/diagnose-shop-grant-order.ts
scripts/recompute-team-streak-2312.ts
scripts/return-shop-grant-order.ts
fineable-approved-audit.md
fines-writeup.md

# Local-only ops scripts (one-off prod remediation, user-specific fixes,
# diagnostics). Contain prod PII; purged from git history, never commit.
/scripts/

# Browser-dump and analysis scratch files at the repo root. Same deal:
# local-only, purged from history.
/amazon-*.md
/macondo-fines-analysis.md
/sourcing-en.md

# Internal prize budgeting sheet. Anything under public/ is served as a
# static asset, so this was downloadable by anyone who guessed the path.
public/images/prizes/prize_budgeting.csv
docs/ari-setup.md
env.prod
